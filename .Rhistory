sqrt(SSE)
# Chunk 1
# Loading the dataset
library(car)
library(DescTools)
library(tidyverse)
data <- PlantGrowth
# Chunk 2
anova(lm(weight ~ group, data = data))
# Chunk 3
# Finding the treatment means
treatment_means <- data %>%
group_by(group) %>%
summarise(mean_wt = mean(weight))
# Replicates
n <- 10
# Treatments
k <- 3
# Total experiments
N <- k*n
# grand mean
grand_mean <- mean(data$weight)
# Error sum of squares
data_with_treatment_mean <- merge(data, treatment_means)
SSE <- sum((data_with_treatment_mean$weight - data_with_treatment_mean$mean_wt)**2)
print(paste0("SSE = ", SSE))
# Treatment sum of squares
SSTr <- n*sum((treatment_means$mean_wt - grand_mean)**2)
print(paste0("SSTr = ", SSTr))
# Mean sum of squared error
MSE <- SSE / (N - k)
print(paste0("MSE = ", MSE))
# Mean sum of square treatment
MSTr <- SSTr / (k - 1)
print(paste0("MSTr = ", MSTr))
# F-statistic
F <- MSTr / MSE
print(paste0("F-statistic = ", F))
# p-value
pf(F, k-1, N-k, lower.tail = FALSE)
# Chunk 4
aov_object <- aov(lm(weight ~ group, data = data))
PostHocTest(aov_object, method = "bonferroni")
# Chunk 5
# Estimates of the pairwise difference of treatment means
print(paste0("Estimated difference between treatment 2 and treatment 1 = ", treatment_means$mean_wt[2] - treatment_means$mean_wt[1]))
print(paste0("Estimated difference between treatment 3 and treatment 1 = ", treatment_means$mean_wt[3] - treatment_means$mean_wt[1]))
print(paste0("Estimated difference between treatment 3 and treatment 2 = ", treatment_means$mean_wt[3] - treatment_means$mean_wt[2]))
# Upper bound of the confidence interval for the estimated difference between treatment 2 and treatment 1
(treatment_means$mean_wt[2] - treatment_means$mean_wt[1]) + sqrt(SSE)
sqrt(SSE)
SSE
anova(lm(weight ~ group, data = data))
MSE
sqrt(MSE)
