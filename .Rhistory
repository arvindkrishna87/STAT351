?pt
# Inputs
n <- 4                      # sample size per group
delta <- 0.5               # difference to detect
sigma <- 0.25              # standard deviation
alpha <- 0.05              # significance level
# Degrees of freedom
df <- 2*n - 2
# Standard error
SE <- sigma * sqrt(2/n)
# Noncentrality parameter
ncp <- delta / SE
# Critical value (two-sided)
t_crit <- qt(1 - alpha/2, df)
# Power calculation
power <- 1 - (pt(t_crit, df, ncp) - pt(-t_crit, df, ncp))
power
